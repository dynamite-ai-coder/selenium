# ---------------------------------------------------------------------------
# AI Browser Agent - example environment file
# Copy to .env for local development:  cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Password required to access the web interface (login page + browser preview)
APP_PASSWORD=Dupa1234@

# DeepSeek API configuration
DEEPSEEK_API_KEY=
# Sensible default model. Override with any model your DeepSeek account
# supports (for example deepseek-v4-flash, deepseek-chat or deepseek-reasoner).
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# HTTP server
PORT=10000
HOST=0.0.0.0

# Optional: set a stable random value so sessions survive restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Force the Secure flag on the session cookie (auto-detected from the request
# by default, so HTTPS on Render works out of the box).
COOKIE_SECURE=false

# Browser / desktop
DISPLAY=:99
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
BROWSER_HEADLESS=false
CDP_URL=http://127.0.0.1:9222
CHROME_BIN=
BROWSER_PROFILE_DIR=browser_profile
DOWNLOADS_DIR=downloads
UPLOADS_DIR=uploads
NOVNC_DIR=/usr/share/novnc

# Agent limits
AGENT_MAX_STEPS=100
AGENT_TASK_TIMEOUT=900
MAX_UPLOAD_MB=10
