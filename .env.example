# ---------------------------------------------------------------------------
# AI Browser Agent - example environment file
# Copy to .env for local development:  cp .env.example .env
# Never commit the real .env file.
# ---------------------------------------------------------------------------

# Password required to access the web interface (login page + browser preview)
APP_PASSWORD=Dupa1234@

# DeepSeek API configuration
DEEPSEEK_API_KEY=
# Sensible default model. Override with any model your DeepSeek account
# supports (for example deepseek-flash or deepseek-v4-pro).
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# HTTP server
PORT=10000
HOST=0.0.0.0

# Optional: set a stable random value so sessions survive restarts.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Force the Secure flag on the session cookie (auto-detected from the request
# by default, so HTTPS on Render works out of the box).
COOKIE_SECURE=false

# Browser / desktop
DISPLAY=:99
SCREEN_WIDTH=1920
SCREEN_HEIGHT=1080
BROWSER_HEADLESS=false
# SeleniumBase Pure CDP Mode picks a free remote-debugging port and publishes
# the real endpoint here; Browser Use attaches to it over CDP.
CDP_URL_FILE=/tmp/cdp_url
# Fallback CDP endpoint, used only when CDP_URL_FILE does not exist.
CDP_URL=http://127.0.0.1:9222
# Optional: Python interpreter that has SeleniumBase installed (the Docker
# image provides /opt/seleniumbase-venv/bin/python automatically).
SELENIUMBASE_PYTHON=
CHROME_BIN=
BROWSER_PROFILE_DIR=browser_profile

# Stealth / localization (all optional, empty = browser defaults).
# Residential/mobile proxy for the whole browser. Accepts "host:port",
# "user:pass@host:port" or a full URL (http://, https://, socks5://).
# Strongly recommended: datacenter IPs (Render) are challenged by Cloudflare
# almost regardless of how stealthy the browser binary is.
BROWSER_PROXY=
# IANA timezone, e.g. Europe/Warsaw (keep it consistent with the proxy).
BROWSER_TZ=
# UI language / locale, e.g. pl-PL or en-US.
BROWSER_LANG=
# Geolocation reported by the browser: "lat,lon", e.g. 52.2297,21.0122.
BROWSER_GEOLOCATION=
DOWNLOADS_DIR=downloads
UPLOADS_DIR=uploads
NOVNC_DIR=/usr/share/novnc

# Cloudflare Bypass (invisible_playwright stealth Firefox)
# When the visible Chromium hits a Cloudflare interstitial ("Just a moment..."),
# the challenge is solved in a patched stealth Firefox and the resulting
# cookies + User-Agent are transplanted into the agent browser over CDP.
# Requires invisible-playwright and its engine (pre-downloaded in Docker).
CF_BYPASS_ENABLED=true
# Timeout for a single bypass attempt (seconds)
CF_BYPASS_TIMEOUT=90
# Run the stealth browser headless (true) or on the container display (false).
# GUI mode (false) is the default: Cloudflare scores a real headed session
# better, and the solve is visible in the noVNC preview.
CF_BYPASS_HEADLESS=false
# 0 = random fingerprint per solve; a fixed integer is reproducible
CF_BYPASS_SEED=0
# UI language: "auto" follows the proxy egress country, or e.g. en-US
CF_BYPASS_LOCALE=auto
# Optional persistent stealth profile (empty = disposable profile per solve)
CF_BYPASS_PROFILE_DIR=
# Click the Turnstile checkbox when the challenge is interactive
CF_BYPASS_CLICK_TURNSTILE=true
# Minimum seconds between attempts for the same host
CF_BYPASS_COOLDOWN=90
# The bypass browser must exit through the same IP as the agent browser, so
# keep BROWSER_PROXY configured in production (residential/mobile recommended).

# Agent limits
AGENT_MAX_STEPS=100
AGENT_TASK_TIMEOUT=900
MAX_UPLOAD_MB=10
